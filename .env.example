# ===== 必填 =====
# 飞书自建应用凭证 (开发者后台 -> 凭证与基础信息)
APP_ID=cli_xxxxxxxxxxxxxxxxx
APP_SECRET=YOUR_APP_SECRET

# 你的网易云 cookie 中 MUSIC_U 项的值（用于下载无损歌曲）
MUSIC_U=YOUR_MUSIC_U

# ===== 可选 =====
# bot 管理员 open_id, 用 "," 分隔
#BOT_ADMIN=ou_xxxxxxxx,ou_yyyyyyyy

# 是否开启 debug 日志
#BOT_DEBUG=false

# 自定义 sqlite3 数据库文件 (默认为 cache.db)
#DATABASE=cache.db

# 日志等级 [panic|fatal|error|warn|info|debug|trace] (默认为 info)
#LOG_LEVEL=info

# 最大自动重试次数 (默认为 3)
#MAX_RETRY_TIMES=3

# 下载超时时长 (单位秒, 默认为 60)
#DOWNLOAD_TIMEOUT=60

# 自定义下载反向代理
#REVERSE_PROXY=114.5.1.4:8080

# 语音方式的 opus 转码参数 (默认 128k / 48000 / 2)
# 若你的飞书客户端无法播放, 尝试改为官方示例参数 16k / 16000 / 1
#OPUS_BITRATE=128k
#OPUS_SAMPLE_RATE=48000
#OPUS_CHANNELS=2
